# Frontend API base URL.
# Used by the old Vue auth pages for Laravel endpoints such as /api/* and /sanctum/csrf-cookie.
VITE_API_BASE_URL=http://127.0.0.1:8013

# Console base URL.
# After successful authentication the old auth pages redirect to /console on this origin.
VITE_DASHBOARD_BASE_URL=http://127.0.0.1:8013

# Optional auth page base URL.
# Leave empty when /login, /register, and /verify-email are served by this Vite app.
VITE_AUTH_BASE_URL=

# reCAPTCHA v2 site key (used on forgot-password page).
# Leave empty to hide the reCAPTCHA widget in development.
VITE_RECAPTCHA_SITE_KEY=

# Production examples
# VITE_API_BASE_URL=https://api.example.com
# VITE_DASHBOARD_BASE_URL=https://panel.example.com
# VITE_AUTH_BASE_URL=https://www.example.com
