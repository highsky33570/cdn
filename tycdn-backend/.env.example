#
# Application
#
# APP_KEY is the primary encryption key for cookies, encrypted model fields, and signed payloads.
# APP_PREVIOUS_KEYS keeps old keys available for decryption during key rotation.
APP_NAME=TyCDN
APP_ENV=local
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=false
# Public backend base URL used when Laravel generates absolute links.
APP_URL=http://localhost:9000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Cost factor for password hashing.
BCRYPT_ROUNDS=12

#
# Logging
#
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#
# Database
#
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

#
# Session and SPA authentication
#
# SESSION_ENCRYPT=true stores encrypted session payloads in the database.
# AUTH_VERIFICATION_EXPIRE is the email verification link lifetime in minutes.
# SANCTUM_STATEFUL_DOMAINS must include every frontend/backend origin that should share session auth.
# SESSION_DOMAIN should stay empty for local IP/localhost testing unless you explicitly need a shared parent domain.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Set to true in production when serving over HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
AUTH_VERIFICATION_EXPIRE=10
SESSION_PATH=/
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5177,localhost:9000,127.0.0.1:5173,127.0.0.1:5177,127.0.0.1:8013,127.0.0.1:8014,127.0.0.1:9000
# Sanctum personal-access-token expiration in minutes. 43200 = 30 days.
# SPA session login uses SESSION_LIFETIME; this caps any bearer tokens issued via createToken().
SANCTUM_EXPIRATION=43200
SESSION_DOMAIN=
# Frontend portal base URL used for verification, reset-password, and dashboard redirects.
FRONTEND_URL=http://localhost:5173
# Comma-separated origins allowed by CORS for browser API requests.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

#
# Queue, cache, filesystem, broadcast
#
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#
# Mail
#
# Outbound mail transport used for verification and password reset emails.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Global outbound mail caps. Exceeding them silently DROPS the message, so keep
# them above your expected registration/reset volume.
MAIL_THROTTLE_PER_MINUTE=20
MAIL_THROTTLE_PER_HOUR=200

#
# AWS / object storage
#
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

#
# Frontend build-time variables exposed to Vite
#
VITE_APP_NAME="${APP_NAME}"

#
# reCAPTCHA v2 Checkbox (forgot-password page)
#
# Get keys at https://www.google.com/recaptcha/admin
# Leave empty to skip captcha validation in development.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Seconds to wait on Google, and whether an unreachable verifier lets requests
# through (true) or blocks them (false).
RECAPTCHA_TIMEOUT=5
RECAPTCHA_FAIL_OPEN=true
# Expose site key to the Vue portal build.
VITE_RECAPTCHA_SITE_KEY="${RECAPTCHA_SITE_KEY}"

#
# EPUSDT payment integration
#
# BASE_URL points to the payment service.
# PID is the merchant id issued by the EPUSDT service; requests fail without it.
# API_TOKEN authenticates create-order requests and signs callbacks.
# QUERY_ORDER_PATH is optional; set it when your EPUSDT deployment exposes an order-query API for reconciliation.
# NOTIFY_URL is the backend callback URL.
# REDIRECT_URL is where the user returns after payment.
# RATE_* controls the fiat exchange-rate source and JSON path.
EPUSDT_BASE_URL=https://pay.example.com
EPUSDT_CREATE_ORDER_PATH=/payments/gmpay/v1/order/create-transaction
EPUSDT_QUERY_ORDER_PATH=/payments/gmpay/v1/order/query
EPUSDT_PID=
EPUSDT_API_TOKEN=
EPUSDT_NOTIFY_URL=https://api.example.com/api/payments/epusdt/notify
EPUSDT_REDIRECT_URL=https://portal.example.com/payment/result
EPUSDT_DEFAULT_CURRENCY=USD
EPUSDT_DEFAULT_TOKEN=usdt
EPUSDT_DEFAULT_NETWORK=TRON
# Minutes a checkout stays payable, and how far back reconciliation looks for
# unsettled orders (keep the lookback well above the TTL to catch late payments).
EPUSDT_ORDER_TTL_MINUTES=30
EPUSDT_RECONCILE_LOOKBACK_MINUTES=1440

#
# CDNfly integration
#
# CDNFLY_OUTBOUND_ENABLED=false keeps local console development from calling a real CDNfly panel.
# CDNFLY_PROVISION_URL is the target endpoint used when provisioning packages.
# CDNFLY_AUTH_* is the generic auth header config for legacy or service-level requests.
# CDNFLY_BASE_URL is the CDNfly panel base URL.
# CDNFLY_ADMIN_API_KEY / SECRET are the admin credentials used by backend-only management and sync flows.
CDNFLY_OUTBOUND_ENABLED=false
# Provisioning attempts per paid order before reconciliation gives up and logs
# an error for manual follow-up.
CDNFLY_MAX_PROVISION_ATTEMPTS=10
# Binds local product slugs to CDNfly package ids, used by ProductSeeder.
# Example: CDNFLY_PACKAGE_IDS="jpn-mini:101,jpn-standard:102"
CDNFLY_PACKAGE_IDS=
CDNFLY_PROVISION_URL=
CDNFLY_TIMEOUT=15
CDNFLY_AUTH_TYPE=bearer
CDNFLY_AUTH_HEADER=Authorization
CDNFLY_AUTH_PREFIX=Bearer
CDNFLY_AUTH_TOKEN=
CDNFLY_ACCEPT_HEADER=application/json
CDNFLY_BASE_URL=https://panel.example.com
CDNFLY_ADMIN_API_KEY=
CDNFLY_ADMIN_API_SECRET=
# 独立加密密钥：将 CDNfly 凭证加密与 APP_KEY 解耦。
# 生成方式：php artisan cdnfly:generate-key
# 生成后执行 php artisan cdnfly:rekey 迁移已有凭证。
CDNFLY_ENCRYPTION_KEY=

#
# Bootstrap admin account
#
# Used to seed or initialize the local admin user if your bootstrap flow needs it.
ADMIN_NAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
